  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,ts,html,css,md,json,vue}\" \"!package*.json\"",
    "format-changelog": "prettier --write --end-of-line lf CHANGELOG.md",
